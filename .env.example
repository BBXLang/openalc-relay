# Documentation only: the Go binary does not automatically read .env files.
# Export these variables in your shell, or use systemd EnvironmentFile.
RELAY_HTTP_ADDR=127.0.0.1:8080
RELAY_DATABASE_PATH=data/relay.db
RELAY_LOG_LEVEL=info

# Required after local owner bootstrap; keep the key file outside Git and separate from database backups.
# RELAY_MASTER_KEY_FILE=/etc/openalc-relay/keys.json
# RELAY_PUBLIC_ORIGIN=https://relay.example.com

# Device pairing, event APIs, communication payload storage, and push are not implemented.
# Do not connect real communication data in this phase.
