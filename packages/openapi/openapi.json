{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenALC Relay API",
    "version": "0.2.0",
    "description": "Implemented health, owner session, short-lived device pairing, revocation, and fixed-type synthetic two-way exchange endpoints. No SMS bodies, numbers, remote sending, vendor push, or general communication-event API is accepted. Public access requires an HTTPS reverse proxy; local HTTP is only a loopback hop."
  },
  "servers": [
    { "url": "http://127.0.0.1:8080", "description": "Local development only" }
  ],
  "security": [],
  "paths": {
    "/v1/pairings": {
      "post": { "operationId": "createPairing", "summary": "Owner creates a five-minute invitation", "security": [{ "ownerCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/Origin" }, { "$ref": "#/components/parameters/CSRF" }], "responses": { "201": { "description": "Invitation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pairing" } } } }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" } } }
    },
    "/v1/pairings/{pairing_id}": {
      "get": { "operationId": "getPairing", "summary": "Owner reads the applicant and comparison code", "security": [{ "ownerCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/PairingID" }], "responses": { "200": { "description": "Invitation and optional applicant", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pairing" } } } }, "401": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" } } }
    },
    "/v1/pairings/{pairing_id}/requests": {
      "post": { "operationId": "requestPairing", "summary": "One prospective device applies to an active invitation", "parameters": [{ "$ref": "#/components/parameters/PairingID" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["device_label"], "properties": { "device_label": { "type": "string", "maxLength": 80 } } } } } }, "responses": { "201": { "description": "Single-use claim token and comparison code; do not log", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PairingRequest" } } } }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "410": { "$ref": "#/components/responses/Problem" } } }
    },
    "/v1/pairings/{pairing_id}/approve": {
      "post": { "operationId": "approvePairing", "summary": "Owner explicitly approves the matching applicant", "security": [{ "ownerCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/PairingID" }, { "$ref": "#/components/parameters/Origin" }, { "$ref": "#/components/parameters/CSRF" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["request_id", "comparison_code"], "properties": { "request_id": { "type": "string", "format": "uuid" }, "comparison_code": { "type": "string", "pattern": "^[0-9]{6}$" } } } } } }, "responses": { "204": { "description": "Approved once" }, "403": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "410": { "$ref": "#/components/responses/Problem" } } }
    },
    "/v1/pairings/{pairing_id}/exchange": {
      "post": { "operationId": "exchangePairing", "summary": "Approved applicant exchanges its scoped claim for a device token once", "parameters": [{ "$ref": "#/components/parameters/PairingID" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["request_id", "claim_token"], "properties": { "request_id": { "type": "string", "format": "uuid" }, "claim_token": { "type": "string", "writeOnly": true } } } } } }, "responses": { "201": { "description": "Device identity and one-time token; do not log", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Device" } } } }, "401": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "410": { "$ref": "#/components/responses/Problem" } } }
    },
    "/v1/devices": {
      "get": { "operationId": "listDevices", "summary": "List up to 100 owner-scoped devices", "security": [{ "ownerCookie": [] }], "responses": { "200": { "description": "Devices", "content": { "application/json": { "schema": { "type": "object", "required": ["devices"], "properties": { "devices": { "type": "array", "items": { "$ref": "#/components/schemas/Device" } } } } } } }, "401": { "$ref": "#/components/responses/Problem" } } }
    },
    "/v1/devices/{device_id}/revoke": {
      "post": { "operationId": "revokeDevice", "summary": "Immediately revoke an owner-scoped device credential", "security": [{ "ownerCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/DeviceID" }, { "$ref": "#/components/parameters/Origin" }, { "$ref": "#/components/parameters/CSRF" }], "responses": { "204": { "description": "Device revoked" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" } } }
    },
    "/v1/devices/{device_id}/synthetic-pings": {
      "post": { "operationId": "createSyntheticPing", "summary": "Owner queues a fixed-type synthetic ping for one device", "security": [{ "ownerCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/DeviceID" }, { "$ref": "#/components/parameters/Origin" }, { "$ref": "#/components/parameters/CSRF" }], "responses": { "201": { "description": "Durably queued ping", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SyntheticPing" } } } }, "404": { "$ref": "#/components/responses/Problem" } } }
    },
    "/v1/synthetic-events": {
      "get": { "operationId": "listSyntheticEvents", "summary": "List up to 100 owner-scoped fixed-type synthetic events", "security": [{ "ownerCookie": [] }], "responses": { "200": { "description": "Synthetic events", "content": { "application/json": { "schema": { "type": "object", "required": ["events"], "properties": { "events": { "type": "array", "items": { "$ref": "#/components/schemas/SyntheticEvent" } } } } } } }, "401": { "$ref": "#/components/responses/Problem" } } }
    },
    "/v1/synthetic-pings/{ping_id}": {
      "get": { "operationId": "getSyntheticPing", "summary": "Read whether the device acknowledged a synthetic ping", "security": [{ "ownerCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/PingID" }], "responses": { "200": { "description": "Ping state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SyntheticPing" } } } }, "404": { "$ref": "#/components/responses/Problem" } } }
    },
    "/v1/agent/synthetic-sync": {
      "post": { "operationId": "syncSyntheticDevice", "summary": "Commit one optional synthetic event and ping acknowledgement, then return pending pings", "security": [{ "deviceBearer": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "properties": { "client_event_id": { "type": "string", "format": "uuid" }, "ack_ping_id": { "type": "string", "format": "uuid" } } } } } }, "responses": { "200": { "description": "Committed event status and pending pings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SyntheticSync" } } } }, "401": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" } } }
    },
    "/v1/session": {
      "post": {
        "operationId": "createOwnerSession",
        "summary": "Log in as the locally bootstrapped owner",
        "parameters": [{ "name": "Origin", "in": "header", "required": true, "schema": { "type": "string", "format": "uri" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordLogin" } } }
        },
        "responses": {
          "200": { "description": "Owner session created; Secure HttpOnly cookie set", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OwnerSession" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      },
      "get": {
        "operationId": "getOwnerSession",
        "summary": "Read the active owner session and CSRF token",
        "security": [{ "ownerCookie": [] }],
        "responses": {
          "200": { "description": "Active owner session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OwnerSession" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      },
      "delete": {
        "operationId": "revokeOwnerSession",
        "summary": "Revoke the active owner session",
        "security": [{ "ownerCookie": [] }],
        "parameters": [
          { "name": "Origin", "in": "header", "required": true, "schema": { "type": "string", "format": "uri" } },
          { "name": "X-CSRF-Token", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Session revoked" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "getLiveness",
        "summary": "Check process liveness independently of the database",
        "responses": {
          "200": {
            "description": "The HTTP process is running",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Healthy" } }
            }
          }
        }
      },
      "head": {
        "operationId": "headLiveness",
        "summary": "Check liveness without a response body",
        "responses": { "200": { "description": "The HTTP process is running" } }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Check the migrated database connection with a bounded timeout",
        "responses": {
          "200": {
            "description": "The database is available",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Healthy" } }
            }
          },
          "503": {
            "description": "The database is unavailable; private error details are omitted",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Unavailable" } }
            }
          }
        }
      },
      "head": {
        "operationId": "headReadiness",
        "summary": "Check readiness without a response body",
        "responses": {
          "200": { "description": "The database is available" },
          "503": { "description": "The database is unavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ownerCookie": { "type": "apiKey", "in": "cookie", "name": "__Host-relay-session" },
      "deviceBearer": { "type": "http", "scheme": "bearer", "description": "Per-device dr_ token; never use the owner cookie" }
    },
    "parameters": {
      "PairingID": { "name": "pairing_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "DeviceID": { "name": "device_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "PingID": { "name": "ping_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "Origin": { "name": "Origin", "in": "header", "required": true, "schema": { "type": "string", "format": "uri" } },
      "CSRF": { "name": "X-CSRF-Token", "in": "header", "required": true, "schema": { "type": "string" } }
    },
    "responses": {
      "Problem": { "description": "Controlled problem response", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/BusinessProblem" } } } }
    },
    "schemas": {
      "Pairing": { "type": "object", "required": ["pairing_id", "expires_at"], "properties": { "pairing_id": { "type": "string", "format": "uuid" }, "expires_at": { "type": "string", "format": "date-time" }, "request": { "$ref": "#/components/schemas/PairingRequest" } } },
      "PairingRequest": { "type": "object", "required": ["request_id", "device_label", "comparison_code", "status"], "properties": { "request_id": { "type": "string", "format": "uuid" }, "device_label": { "type": "string" }, "comparison_code": { "type": "string" }, "status": { "type": "string", "enum": ["pending", "approved", "exchanged"] }, "claim_token": { "type": "string", "writeOnly": true } } },
      "Device": { "type": "object", "required": ["device_id", "device_label", "revoked"], "properties": { "device_id": { "type": "string", "format": "uuid" }, "device_label": { "type": "string" }, "revoked": { "type": "boolean" }, "device_token": { "type": "string", "writeOnly": true } } },
      "SyntheticEvent": { "type": "object", "required": ["device_id", "client_event_id", "received_at"], "properties": { "device_id": { "type": "string", "format": "uuid" }, "client_event_id": { "type": "string", "format": "uuid" }, "received_at": { "type": "string", "format": "date-time" } } },
      "SyntheticPing": { "type": "object", "required": ["ping_id", "device_id", "created_at"], "properties": { "ping_id": { "type": "string", "format": "uuid" }, "device_id": { "type": "string", "format": "uuid" }, "created_at": { "type": "string", "format": "date-time" }, "acknowledged_at": { "type": "string", "format": "date-time" } } },
      "SyntheticSync": { "type": "object", "required": ["pings"], "properties": { "event_status": { "type": "string", "enum": ["accepted", "duplicate"] }, "pings": { "type": "array", "items": { "$ref": "#/components/schemas/SyntheticPing" } } } },
      "PasswordLogin": {
        "type": "object", "additionalProperties": false, "required": ["password"],
        "properties": { "password": { "type": "string", "description": "12 to 1024 UTF-8 bytes", "writeOnly": true } }
      },
      "OwnerSession": {
        "type": "object", "additionalProperties": false,
        "required": ["owner_id", "expires_at", "csrf_token"],
        "properties": {
          "owner_id": { "type": "string", "format": "uuid" },
          "expires_at": { "type": "string", "format": "date-time" },
          "csrf_token": { "type": "string" }
        }
      },
      "BusinessProblem": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "title", "status", "code"],
        "properties": {
          "type": { "type": "string" }, "title": { "type": "string" },
          "status": { "type": "integer" }, "code": { "type": "string" }
        }
      },
      "Healthy": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": { "status": { "type": "string", "const": "ok" } }
      },
      "Unavailable": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": { "status": { "type": "string", "const": "unavailable" } }
      }
    }
  }
}
